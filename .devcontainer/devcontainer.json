{
  "name": "refusal-engineering",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --user pre-commit && pre-commit install --install-hooks || true",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "yzhang.markdown-all-in-one"]
    }
  },
  "remoteEnv": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
